# ═══════════════════════════════════════════════════════════════════
# SatQuery AI — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ─── Secrets & credentials ──────────────────────────────────────────
# GEE service account key (NEVER commit this)
satquery-ai-507419-bd42e79609ce.json
*.json.key
*-credentials.json
*-service-account.json

# Environment variable files
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ─── Python virtual environment ─────────────────────────────────────
env/
venv/
.venv/
ENV/

# ─── Python cache & compiled files ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
.Python

# ─── Python packaging / build ───────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl
MANIFEST

# ─── Testing & coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.coveragerc
nosetests.xml

# ─── Type checking ──────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pyright/

# ─── Jupyter notebooks ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Node / frontend ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Vite build output
frontend/dist/
frontend/.vite/
frontend/.vite-temp/

# ─── Sessions & exports (runtime-generated) ─────────────────────────
sessions/
backend/sessions/

# ─── Model weights (large binary files — host on HuggingFace Hub) ───
backend/models/weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf

# ─── Raster / imagery outputs ───────────────────────────────────────
*.tif
*.tiff
*.geotiff

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ─── OS generated ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDEs & editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ─── Temporary files ────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
