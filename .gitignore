# ═══════════════════════════════════════════════════════════════════
# SatQuery AI — .gitignore
# ═══════════════════════════════════════════════════════════════════

# ─── Secrets & credentials ──────────────────────────────────────────
backend/satquery-ai-*.json
satquery-ai-*.json
*.json.key
*-credentials.json
*-service-account.json

# Kaggle API credentials
kaggle.json
~/.kaggle/kaggle.json

# Environment variable files (contain API keys)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production
*.env

# ─── Datasets & Local Data ─────────────────────────────────────────
data/
datasets/

# ─── Python virtual environment ─────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.python-version

# ─── Python cache & compiled files ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
.Python

# ─── Python packaging / build ───────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
*.whl
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ─── Testing & coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.coveragerc
nosetests.xml

# ─── Type checking ──────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ─── Jupyter notebooks ──────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Node / frontend ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock

# Vite build output
frontend/dist/
frontend/.vite/
frontend/.vite-temp/

# ─── Sessions & exports (runtime-generated) ─────────────────────────
sessions/
backend/sessions/
exports/

# ─── Model weights (large binary files — hosted on HuggingFace Hub) ───
backend/models/weights/
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf
*.pkl
*.pickle

# ─── Raster / imagery outputs ───────────────────────────────────────
*.tif
*.tiff
*.geotiff
*.jp2
*.h5
*.hdf5
*.nc

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ─── OS generated ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# ─── IDEs & editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
.project
.classpath
.settings/

# ─── Temporary / scratch files ──────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
*.cache
.cache/
scratch/
test_output/
*.test.json

# ─── Agent & IDE metadata ──────────────────────────────────────────
.gemini/
.agents/
.system_generated/
*.tsbuildinfo


docs/
ref_docs/